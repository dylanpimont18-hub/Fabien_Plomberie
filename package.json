{
  "name": "fremont-plomberie-services",
  "version": "1.0.0",
  "private": true,
  "description": "Site vitrine de Frémont Plomberie Services — Eleventy, HTML/CSS/JS statique",
  "scripts": {
    "dev": "SITE_MODE=demo eleventy --serve",
