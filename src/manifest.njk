---
permalink: /manifest.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": "{{ site.name }}",
  "short_name": "{{ site.shortName }}",
  "description": "{{ site.tagline }}",
  "start_url": "{{ '/' | url }}",
  "scope": "{{ '/' | url }}",
  "display": "browser",
  "lang": "fr",
  "background_color": "#F6F3EE",
  "theme_color": "#0E1A2B",
  "icons": [
    { "src": "{{ '/assets/img/icon-192.png' | url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/img/icon-512.png' | url }}", "sizes": "512x512", "type": "image/png" },
    { "src": "{{ '/favicon.svg' | url }}", "sizes": "any", "type": "image/svg+xml" }
  ]
}
