{#- Carte SVG stylisée de la zone d'intervention (coordonnées relatives, pas un fond de carte) -#}
<div class="map">
  <svg viewBox="0 0 720 420" role="group" aria-labelledby="map-title map-desc">
    <title id="map-title">Zone d'intervention autour de Vierzon</title>
    <desc id="map-desc">Carte stylisée : cercle d'intervention d'environ 50 km centré sur Vierzon, avec les communes desservies et l'atelier à Vignoux-sur-Barangeon.</desc>
    <defs>
      <pattern id="map-trame" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="8" stroke="#0E1A2B" stroke-opacity=".06"/>
      </pattern>
    </defs>
    <!-- Rayon d'intervention -->
    <circle cx="300" cy="230" r="205" fill="url(#map-trame)"/>
    <circle cx="300" cy="230" r="205" fill="none" stroke="#B87333" stroke-width="1.5" stroke-dasharray="4 6"/>
    <text x="300" y="38" text-anchor="middle" font-size="12" font-weight="600" letter-spacing="1.5" fill="#8A5422">RAYON D'ENVIRON 50 KM</text>
    <!-- Rivières (tracés stylisés) : le Cher et l'Yèvre -->
    <path d="M40 300 C 120 280, 200 250, 300 232 S 420 200, 470 170" fill="none" stroke="#1F3350" stroke-opacity=".35" stroke-width="2"/>
    <path d="M300 232 C 360 250, 440 270, 560 300" fill="none" stroke="#1F3350" stroke-opacity=".35" stroke-width="2"/>
    <text x="70" y="318" font-size="11" fill="#5A5E66" font-style="italic">le Cher</text>
    <text x="470" y="292" font-size="11" fill="#5A5E66" font-style="italic">l'Yèvre</text>
    <!-- Communes -->
    {%- for z in zones %}
    {%- set zx = z.map.x %}{%- set zy = z.map.y %}
    <a class="map__city {{ 'map__home' if z.map.home }}" href="{{ ('/zones/' + z.slug + '/') | url }}" aria-label="Plombier à {{ z.city }}">
      <title>Plombier à {{ z.city }}</title>
      {%- if z.map.anchor == "end" %}
      <rect x="{{ zx - 150 }}" y="{{ zy - 16 }}" width="164" height="32" rx="16" fill="transparent" stroke="transparent"/>
      {%- else %}
      <rect x="{{ zx - 14 }}" y="{{ zy - 16 }}" width="{{ 40 + (z.city | length) * 8 }}" height="32" rx="16" fill="transparent" stroke="transparent"/>
      {%- endif %}
      {%- if z.map.home %}
      <circle cx="{{ zx }}" cy="{{ zy }}" r="9" fill="#0E1A2B"/>
      <path d="M{{ zx - 4 }} {{ zy - 4 }} v9 M{{ zx - 5 }} {{ zy - 4 }} h2 M{{ zx - 4 }} {{ zy - 2 }} h6 M{{ zx - 4 }} {{ zy + 2 }} h4" stroke="#D9A066" stroke-width="1.5" stroke-linecap="round" fill="none"/>
      {%- else %}
      <circle cx="{{ zx }}" cy="{{ zy }}" r="6"/>
      {%- endif %}
      <text x="{{ zx + (12 if z.map.anchor == 'start' else -12) }}" y="{{ zy + 5 }}" text-anchor="{{ z.map.anchor }}">{{ z.city }}</text>
      {%- if z.map.home %}<text x="{{ zx + 12 }}" y="{{ zy + 21 }}" font-size="10" fill="#8A5422" font-weight="600" letter-spacing="1">ATELIER</text>{% endif %}
    </a>
    {%- endfor %}
  </svg>
  <ul class="map__list" aria-label="Communes desservies">
    {%- for z in zones %}
    <li><a href="{{ ('/zones/' + z.slug + '/') | url }}">{{ z.city }}</a></li>
    {%- endfor %}
  </ul>
</div>
